{
  "name": "reprompt-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reprompt API Documentation",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "npm run generate && next dev --hostname 0.0.0.0",
    "build": "npm run generate && npm run check && next build",
    "start": "next start --hostname 0.0.0.0",
    "generate": "node --import tsx scripts/generate-docs.ts && fumadocs-mdx",
    "sync:openapi": "node --import tsx scripts/sync-openapi.ts",
    "typecheck": "npm run generate && tsc --noEmit",
    "check": "node --import tsx scripts/check-docs.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.5.2",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
